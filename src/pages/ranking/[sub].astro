---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { TOPICS_REGISTRY } from '../../data/topics';

export async function getStaticPaths() {
  const subSlugs = [
    'overall',
    'stability',
    'value',
    'speed',
    'price',
    'ai',
    'streaming',
    'nodes',
    'beginner'
  ];

  return subSlugs.map((sub) => ({
    params: { sub },
    props: { sub, topicKey: `ranking/${sub}` }
  }));
}

const { sub, topicKey } = Astro.props;
const topicNode = TOPICS_REGISTRY[topicKey] || {
  slug: `ranking/${sub}`,
  path: `/ranking/${sub}/`,
  title: `${sub} 机场排行榜`,
  shortName: `${sub} 排行`,
  seoTitle: `${sub} 机场排行榜｜2026专业排名 - 网络服务指南`,
  description: `针对 ${sub} 需求的最新网络服务商排行榜单与测评依据。`,
  type: 'Pillar',
  priority: 'P1',
  parentSlug: 'ranking',
  category: 'ranking',
  keywords: [`${sub} 机场排行`],
  searchIntent: 'Commercial',
  coreAnswer: `本榜单基于客观测速数据、丢包率与长时间SLA表现进行排名。`
};

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const filteredArticles = allArticles.filter((art) => art.data.category === 'ranking' || art.data.category === 'recommend');
---

<PillarLayout
  categorySlug="ranking"
  title={topicNode.title}
  seoTitle={topicNode.seoTitle}
  description={topicNode.description}
  coreAnswer={topicNode.coreAnswer}
  articles={filteredArticles}
/>
