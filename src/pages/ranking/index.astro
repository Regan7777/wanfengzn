---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';

const articles = await getCollection('articles', (entry) => {
  return !entry.data.draft && (entry.data.category === 'ranking' || entry.data.category === 'recommend');
});
articles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const rankingFaqs = [
  {
    question: "排行榜的评估维度包含哪些？",
    answer: "排行榜综合考量：1. 晚高峰20:00-23:00真实丢包率与测速；2. 运营时间长短（是否超过3年）；3. 专线比例；4. 客服工单响应速度。"
  },
  {
    question: "排行榜多久更新一次？",
    answer: "我们每月进行一次例行网络测试，并根据服务商线路调整实时更新榜单排名，确保数据的准确性与时效性。"
  }
];
---

<PillarLayout
  categorySlug="ranking"
  title="2026机场排行榜单｜综合、稳定与性价比排名"
  description="晚风指南2026网络服务商综合排行榜单：基于晚高峰真实测速、节点丢包率、物理线路架构、SLA高可用性与真实用户长期口碑进行全方位多维度量化评估。系统涵盖综合天梯榜、晚高峰稳定榜与高性价比月付榜，为各类用户提供客观透明且可靠的选型参考。"
  coreAnswer="排行榜并非一成不变，推荐用户根据自己的实际预算与需求看榜选方案：办公选稳定专线榜，学生选高性价比榜。"
  articles={articles}
  faqs={rankingFaqs}
/>
