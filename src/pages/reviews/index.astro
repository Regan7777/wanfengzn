import PillarLayout from '../../layouts/PillarLayout.astro';
import ComparisonTable, { type ComparisonRow } from '../../components/ComparisonTable.astro';

const articles = await getCollection('articles', (entry) => {
  return !entry.data.draft && (entry.data.category === 'reviews' || entry.data.category === 'recommend');
});
articles.sort((a, b) => {
  if (a.slug === 'shenxing-airport-review-2026') return -1;
  if (b.slug === 'shenxing-airport-review-2026') return 1;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});

