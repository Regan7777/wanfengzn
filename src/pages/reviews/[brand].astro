---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import ComparisonTable, { type ComparisonRow } from '../../components/ComparisonTable.astro';

export async function getStaticPaths() {
  const brandSlugs = [
    'shenxing', 'dalaoyun', 'shandianshu', 'liulianyun', 'huanqiuti', 
    'yunjiexian', 'edgenova', 'yuezhianmian', 'feiv', 'lingdongyun',
    'yiyuan', 'peiqian', 'naixi', 'feinio', 'jike',
    'flybit', 'wangji', 'wgetcloud', 'flowercloud', 'yizhi', 'yangfan',
    'ermaoyun', 'jisucloud', 'liangxin', 'chuixue', 'kdj'
  ];

  return brandSlugs.map((brand) => ({
    params: { brand },
    props: { brand }
  }));
}

const { brand } = Astro.props;

