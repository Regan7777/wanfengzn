---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { TOPICS_REGISTRY } from '../../data/topics';

export async function getStaticPaths() {
  const subSlugs = [
    'chatgpt',
    'claude',
    'gemini',
    'ai',
    'video',
    'social',
    'office',
    'remote-work',
    'coding',
    'multi-device'
  ];

  return subSlugs.map((sub) => ({
    params: { sub },
    props: { sub, topicKey: `use-case/${sub}` }
  }));
}

const { sub, topicKey } = Astro.props;
const topicNode = TOPICS_REGISTRY[topicKey] || {
  slug: `use-case/${sub}`,
  path: `/use-case/${sub}/`,
  title: `${sub.toUpperCase()} 场景专属网络服务选择指南`,
  shortName: `${sub} 场景`,
  seoTitle: `${sub.toUpperCase()} 场景专属网络服务与线路选择指南 - 晚风指南`,
  description: `晚风指南针对 ${sub} 特定业务使用场景精选的高品质网络连接方案：重点考察原生住宅IP纯净度、4K超清大吞吐峰值带宽、晚高峰超低网络延迟及多设备协同在线稳定性，兼顾抗封锁与长连接保活，帮助专业用户与出海团队精准选购最匹配的高可靠服务。`,
  type: 'Pillar',
  priority: 'P1',
  parentSlug: 'use-case',
  category: 'use-case',
  keywords: [`${sub} 机场推荐`, `${sub} 节点`, `${sub} 专属网络`],
  searchIntent: 'Commercial',
  coreAnswer: `为保证 ${sub} 的流畅体验，建议优先选择具备原生住宅 IP 或独享入口的节点。`
};

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const filteredArticles = allArticles.filter((art) => art.data.category === 'use-case' || art.data.category === 'recommend');
---

<PillarLayout
  categorySlug="use-case"
  title={topicNode.title}
  seoTitle={topicNode.seoTitle}
  description={topicNode.description}
  coreAnswer={topicNode.coreAnswer}
  articles={filteredArticles}
/>
