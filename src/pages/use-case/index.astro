---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';

const articles = await getCollection('articles', (entry) => {
  return !entry.data.draft && (entry.data.category === 'use-case' || entry.data.category === 'recommend');
});
articles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<PillarLayout
  categorySlug="use-case"
  title="场景化服务选择｜AI平台、流媒体、游戏与协同办公"
  description="针对 ChatGPT / Claude / Gemini AI 开发交流环境、4K 8K 跨国流媒体解锁与外服游戏高品质体验提供针对性硬件方案。"
  coreAnswer="AI平台要求纯净住宅原生IP；4K流媒体要求高带宽保障；游戏要求极致低延迟与0丢包率。"
  articles={articles}
/>
