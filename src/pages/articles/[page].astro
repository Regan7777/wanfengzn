---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleListItem from '../../components/ArticleListItem.astro';
import Pagination from '../../components/Pagination.astro';
import { getCanonicalUrl } from '../../lib/utils';
import { generateBreadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  articles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

  return paginate(articles, { pageSize: 12 });
}

const { page } = Astro.props;
const currentUrl = getCanonicalUrl(`/articles/${page.currentPage}/`);
const breadcrumbs = [
  { name: '文章总览', url: '/articles/' },
  { name: `第 ${page.currentPage} 页`, url: `/articles/${page.currentPage}/` }
];
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={`全部网络服务与机场评测文章列表（第 ${page.currentPage} 页）- 晚风指南`}
  description={`晚风指南精选文章与深度评测归档（第 ${page.currentPage} 页）：汇总收录2026最新高性价比稳定机场推荐排行、IEPL/IPLC内网专线深度测速报告、Windows/Mac/iOS/Android主流客户端配置图文教程与网络连接故障排查自检手册，助你快速掌握选型核心技巧。`}
  canonicalUrl={currentUrl}
  schemaData={breadcrumbSchema}
>
  <div class="container page-container">
    <Breadcrumb items={breadcrumbs} />

    <header class="page-header">
      <h1 class="page-title">全部文章 - 第 {page.currentPage} 页</h1>
      <p class="page-subtitle">共 {page.total} 篇网络服务选择与使用指南</p>
    </header>

    <div class="article-list">
      {page.data.map((article) => (
        <ArticleListItem article={article} headingLevel="h2" />
      ))}
    </div>

    <Pagination currentPage={page.currentPage} totalPages={page.lastPage} baseUrl="/articles/" />
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 900px;
  }
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-title {
    font-size: 2.1rem;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }
  .article-list {
    margin-bottom: 2.5rem;
  }
</style>
