---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { TOPICS_REGISTRY } from '../../data/topics';

export async function getStaticPaths() {
  const subSlugs = [
    'dns',
    'timeout',
    'subscription-failed',
    'ai-blocked',
    'slow-loading',
    'proxy-error'
  ];

  return subSlugs.map((sub) => ({
    params: { sub },
    props: { sub, topicKey: `problems/${sub}` }
  }));
}

const { sub, topicKey } = Astro.props;
const topicNode = TOPICS_REGISTRY[topicKey] || {
  slug: `problems/${sub}`,
  path: `/problems/${sub}/`,
  title: `${sub.toUpperCase()} 常见网络故障排查`,
  shortName: `${sub} 排错`,
  seoTitle: `${sub.toUpperCase()} 常见网络故障排查与解决办法 - 网络服务指南`,
  description: `针对 ${sub} 故障现象进行原因分析、诊断步骤与具体解决方案说明。`,
  type: 'Pillar',
  priority: 'P1',
  parentSlug: 'problems',
  category: 'problems',
  keywords: [`${sub} 解决`],
  searchIntent: 'Informational',
  coreAnswer: `请按照‘检查本地系统时间 -> 更新订阅链接 -> 切换节点 -> 重启代理服务’的顺序逐步排查。`
};

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const filteredArticles = allArticles.filter((art) => art.data.category === 'problems');
---

<PillarLayout
  categorySlug="problems"
  title={topicNode.title}
  seoTitle={topicNode.seoTitle}
  description={topicNode.description}
  coreAnswer={topicNode.coreAnswer}
  articles={filteredArticles}
/>
