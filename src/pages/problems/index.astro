---
import { getCollection } from "astro:content";
import PillarLayout from "../../layouts/PillarLayout.astro";

const articles = await getCollection("articles", (entry) => {
  return !entry.data.draft && entry.data.category === "problems";
});
articles.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<PillarLayout
  categorySlug="problems"
  title="常见网络故障与错误连接排查指南"
  description="晚风指南网络故障排除速查手册：系统排查节点连接超时、订阅更新失败、DNS污染与域名解析缓慢、部分海外网站及App无法打开等高频问题。提供手把手自检诊断流程、系统时间校准及客户端分流规则修复方案，细节详尽，手把手教你快速恢复高速稳定的全球网络连接。"
  coreAnswer="遇到打不开节点时，请优先检查：1. 系统时间是否对准；2. 订阅链接是否过期；3. 尝试更新订阅与更换节点。"
  articles={articles}
/>
