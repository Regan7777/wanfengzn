---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCanonicalUrl } from '../../lib/utils';
import { generateBreadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const tagSet = new Set<string>();

  articles.forEach((art) => {
    if (art.data.tags) {
      art.data.tags.forEach((tag) => tagSet.add(tag));
    }
  });

  return Array.from(tagSet).map((tag) => {
    const filtered = articles.filter((a) => a.data.tags?.includes(tag));
    filtered.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
    return {
      params: { tag },
      props: { tag, articles: filtered }
    };
  });
}

const { tag, articles } = Astro.props;
const currentUrl = getCanonicalUrl(`/tag/${encodeURIComponent(tag)}/`);

const breadcrumbs = [
  { name: '标签归档', url: '/articles/' },
  { name: `#${tag}`, url: `/tag/${encodeURIComponent(tag)}/` }
];
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={`#${tag} 标签相关精选文章与深度评测汇总（共 ${articles.length} 篇）- 晚风指南`}
  description={`晚风指南 #${tag} 主题聚合页：精选整理收录 ${articles.length} 篇与 ${tag} 相关的实测报告、配置教程与网络线路选择指南，助你快速找到所需内容。`}
  canonicalUrl={currentUrl}
  schemaData={breadcrumbSchema}
>
  <div class="container page-container">
    <Breadcrumb items={breadcrumbs} />

    <header class="page-header">
      <h1 class="page-title">#{tag} 主题标签归档</h1>
      <p class="page-subtitle">为您匹配到 {articles.length} 篇相关深度解析与指南文章</p>
    </header>

    <div class="card-grid">
      {articles.map((article) => (
        <ArticleCard article={article} headingLevel="h2" />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  .page-header {
    margin-bottom: 2rem;
  }
  .page-title {
    font-size: 2.1rem;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }
</style>
