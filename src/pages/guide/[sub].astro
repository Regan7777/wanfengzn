---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { TOPICS_REGISTRY } from '../../data/topics';

export async function getStaticPaths() {
  const subSlugs = [
    'what-is-airport',
    'what-is-node',
    'subscription-explained',
    'glossary'
  ];

  return subSlugs.map((sub) => ({
    params: { sub },
    props: { sub, topicKey: `guide/${sub}` }
  }));
}

const { sub, topicKey } = Astro.props;
const topicNode = TOPICS_REGISTRY[topicKey] || {
  slug: `guide/${sub}`,
  path: `/guide/${sub}/`,
  title: `${sub} 新手零基础入门与科普指南`,
  shortName: `${sub} 科普`,
  seoTitle: `${sub} 新手零基础科普入门指南与核心概念 - 晚风指南`,
  description: `适合零基础新手用户的 ${sub} 概念通俗科普：系统拆解底层物理工作原理、基础运行机制与常见误区，助你快速建立正确的网络使用认知。`,
  type: 'Pillar',
  priority: 'P1',
  parentSlug: 'guide',
  category: 'guide',
  keywords: [`${sub} 入门`, `${sub} 科普`],
  searchIntent: 'Informational',
  coreAnswer: `搞懂基础概念是安全、稳定使用网络连接服务的第一步。`
};

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const filteredArticles = allArticles.filter((art) => art.data.category === 'guide' || art.data.tags.includes('新手指南'));
---

<PillarLayout
  categorySlug="guide"
  title={topicNode.title}
  seoTitle={topicNode.seoTitle}
  description={topicNode.description}
  coreAnswer={topicNode.coreAnswer}
  articles={filteredArticles}
/>
