---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import ComparisonTable, { type ComparisonRow } from '../../components/ComparisonTable.astro';

// 获取分类为 recommend 的文章
const articles = await getCollection('articles', (entry) => {
  return !entry.data.draft && (entry.data.category === 'recommend' || entry.data.tags.includes('机场推荐'));
});
articles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const recommendFaqs = [
  {
    question: "2026年稳定‘机场推荐’应该看哪些指标？",
    answer: "重点看三点：1. 晚高峰20:00-23:00丢包率是否低于1%；2. 线路是否采用BGP多线中转或直连协议优化；3. 是否支持月付与折扣优惠以规避风险。"
  },
  {
    question: "机场推荐和普通代理 VPN 有什么区别？",
    answer: "通常所说的‘机场’是指支持 Clash、Sing-box 等多平台客户端订阅服务的网络集群，节点丰富且可以智能分流国内与海外流量，比传统全局VPN速度更快、更省电。"
  },
  {
    question: "为什么有些推荐榜单里的服务跑路了？",
    answer: "许多垃圾宣传站点为了佣金推荐劣质超卖服务。本站所有推荐服务均建立在长期测速、SLA可用性监测与月付安全原则基础之上。"
  }
];

