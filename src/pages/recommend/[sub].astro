---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { TOPICS_REGISTRY } from '../../data/topics';
import ComparisonTable, { type ComparisonRow } from '../../components/ComparisonTable.astro';

export async function getStaticPaths() {
  const subSlugs = [
    'stable',
    'value',
    'budget',
    'beginner',
    'premium',
    'long-term',
    'monthly',
    'yearly',
    'payg',
    'ai',
    'streaming',
    'work',
    'gaming',
    'multi-device'
  ];

  return subSlugs.map((sub) => {
    const topicKey = `recommend/${sub}`;
    return {
      params: { sub },
      props: { sub, topicKey }
    };
  });
}

const { sub, topicKey } = Astro.props;
const topicNode = TOPICS_REGISTRY[topicKey] || {
  slug: `recommend/${sub}`,
  path: `/recommend/${sub}/`,
  title: `${sub} 机场推荐`,
  shortName: `${sub} 推荐`,
  seoTitle: `${sub} 机场推荐｜2026专业指南 - 网络服务指南`,
  description: `关于 ${sub} 机场推荐的专题选购说明与优缺点分析。`,
  type: 'Pillar',
  priority: 'P1',
  parentSlug: 'recommend',
  category: 'recommend',
  keywords: [`${sub} 机场推荐`],
  searchIntent: 'Commercial',
  coreAnswer: `针对 ${sub} 需求，建议重点关注晚高峰稳定度与线路质量。`
};

// 获取包含此关键词或所属分类的文章
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const filteredArticles = allArticles.filter((art) => {
  const matchCategory = art.data.category === 'recommend';
  const matchTag = art.data.tags?.some((t) => topicNode.keywords.some((k) => k.includes(t) || t.includes(k)));
  return matchCategory || matchTag;
});
filteredArticles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// 对比数据
const comparisonData: ComparisonRow[] = [
  {
