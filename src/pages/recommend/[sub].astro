    suitability: `适合 ${topicNode.shortName} 核心需求`,
    affLink: 'https://wuhan01.shenxingaff.com/#/?code=WUQMrgI8',
    linkText: '直达官网'
  },
  {
    name: '大佬云',
    type: 'BGP中转 / Anycast',
    rating: '9.75',
    entryPrice: '¥10/月起',
    features: ['稳定老牌', '超值体验', '多线路冗余', '工单极速响应'],
    suitability: `适合 ${topicNode.shortName} 入门体验`,
    affLink: 'https://fugui0077.dalaoyunaff.com/#/?code=1o7gYhTL',
    linkText: '直达官网'
  },
  {
    name: '闪电鼠',
    type: 'IEPL专线 / Shadowsocks',
    rating: '9.7',
    entryPrice: '¥15/月起',
    features: ['全专线架构', '超低延迟', '全平台支持', '原生IP解锁'],
    suitability: `适合 ${topicNode.shortName} 极速需求`,
    affLink: 'https://fugui0077.shandianshuaff.com/#/?code=I2yK9PfK',
    linkText: '直达官网'
  },
  {
    name: '榴莲云',
    type: 'BGP中转 / Trojan',
    rating: '9.6',
    entryPrice: '¥12/月起',
    features: ['性价比首选', 'BGP中转', '大流量包', 'AI/流媒体解锁'],
    suitability: `适合 ${topicNode.shortName} 性价比需求`,
    affLink: 'https://fugui007.liulianyunaff.com/#/?code=Y6A1M1MN',
    linkText: '直达官网'
  },
  {
    name: '环球梯',
    type: 'IEPL专线 / VLESS',
    rating: '9.5',
    entryPrice: '¥18/月起',
    features: ['全球多节点', '晚高峰保障', '高速稳定', '全设备并发'],
    suitability: `适合 ${topicNode.shortName} 稳定需求`,
    affLink: 'https://fugui0077.huanqiutiaff.com/#/?code=rJyQn4xG',
    linkText: '直达官网'
  },
  {
    name: '云界限',
