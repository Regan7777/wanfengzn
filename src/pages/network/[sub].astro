---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { TOPICS_REGISTRY } from '../../data/topics';

export async function getStaticPaths() {
  const subSlugs = [
    'iepl',
    'iplc',
    'direct',
    'transit',
    'cn2',
    'cmi',
    'native-ip',
    'residential-ip',
    'shared-ip',
    'dedicated-ip',
    'latency',
    'packet-loss',
    'peak-hours'
  ];

  return subSlugs.map((sub) => ({
    params: { sub },
    props: { sub, topicKey: `network/${sub}` }
  }));
}

const { sub, topicKey } = Astro.props;
const topicNode = TOPICS_REGISTRY[topicKey] || {
  slug: `network/${sub}`,
  path: `/network/${sub}/`,
  title: `${sub.toUpperCase()} 线路架构与核心知识详解`,
  shortName: `${sub} 知识`,
  seoTitle: `${sub.toUpperCase()} 线路架构与核心知识详解 - 晚风指南网络评测`,
  description: `晚风指南硬核解析 ${sub} 网络线路：剖析其物理传输架构、入口与出口路由、晚高峰丢包率及在实际科学上网和流媒体播放中的稳定性表现。`,
  type: 'Pillar',
  priority: 'P1',
  parentSlug: 'network',
  category: 'network',
  keywords: [`${sub} 线路`, `${sub} 专线`],
  searchIntent: 'Informational',
  coreAnswer: `搞懂 ${sub} 线路特征，有助于挑选出真正符合您稳定性要求的网络方案。`
};

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const filteredArticles = allArticles.filter((art) => art.data.category === 'network' || art.data.category === 'recommend');
---

<PillarLayout
  categorySlug="network"
  title={topicNode.title}
  seoTitle={topicNode.seoTitle}
  description={topicNode.description}
  coreAnswer={topicNode.coreAnswer}
  articles={filteredArticles}
/>
