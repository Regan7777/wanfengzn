---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title?: string;
  class?: string;
}

const { headings, title = "此页内容", class: className = "" } = Astro.props;

// 仅获取 H2 和 H3 标题
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class:list={['toc-widget', className]} aria-label="此页内容">
    <div class="toc-header">
      <span class="toc-title">{title}</span>
      <span class="toc-icon" aria-hidden="true">☷</span>
    </div>
    <ul class="toc-list">
      {filteredHeadings.map((heading) => (
        <li class:list={['toc-item', `depth-${heading.depth}`]}>
          <a
            href={`#${heading.slug}`}
            class="toc-link"
            data-target={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function initTOC() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-widget .toc-link');
    if (!tocLinks.length) return;

    const headingElements: { id: string; el: HTMLElement }[] = [];
    
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-target');
      if (!slug) return;
      const el = document.getElementById(slug);
      if (el && !headingElements.some((h) => h.id === slug)) {
        headingElements.push({ id: slug, el });
      }
    });

    if (!headingElements.length) return;

    // Smooth click handler
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const slug = link.getAttribute('data-target');
        if (!slug) return;
        const targetEl = document.getElementById(slug);
        if (targetEl) {
          e.preventDefault();
          const headerOffset = 80;
          const elementPosition = targetEl.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
          history.pushState(null, '', `#${slug}`);
          setActive(slug);
        }
      });
    });

    function setActive(activeSlug: string) {
      tocLinks.forEach((l) => l.classList.remove('active'));
      const activeLinks = document.querySelectorAll<HTMLAnchorElement>(
        `.toc-widget .toc-link[data-target="${CSS.escape(activeSlug)}"]`
      );
      activeLinks.forEach((l) => l.classList.add('active'));
    }

    // Scrollspy with scroll listener
    let ticking = false;
    function updateActiveHeading() {
      const scrollY = window.pageYOffset;
      const headerOffset = 100;

      let currentSlug = '';
      for (let i = 0; i < headingElements.length; i++) {
        const top = headingElements[i].el.getBoundingClientRect().top + scrollY - headerOffset;
        if (scrollY >= top - 20) {
          currentSlug = headingElements[i].id;
        } else {
          break;
        }
      }

      if (!currentSlug && headingElements.length > 0) {
        currentSlug = headingElements[0].id;
      }

      if (currentSlug) {
        setActive(currentSlug);
      }
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateActiveHeading);
        ticking = true;
      }
    }, { passive: true });

    // Initial trigger
    updateActiveHeading();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTOC);
  } else {
    initTOC();
  }
  document.addEventListener('astro:page-load', initTOC);
</script>

<style>
  .toc-widget {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-main, #0f172a);
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    letter-spacing: 0.01em;
  }

  .toc-icon {
    font-size: 0.95rem;
    color: var(--color-text-muted, #64748b);
    line-height: 1;
    font-weight: 400;
    user-select: none;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--color-border, #e2e8f0);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: block;
    color: var(--color-text-secondary, #475569);
    text-decoration: none;
    padding: 0.25rem 0.5rem 0.25rem 0.75rem;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    word-break: break-word;
    font-size: 0.84rem;
  }

  .toc-item.depth-2 > .toc-link {
    font-weight: 500;
  }

  .toc-item.depth-3 > .toc-link {
    padding-left: 1.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted, #64748b);
  }

  .toc-link:hover {
    color: var(--color-accent, #2563eb);
  }

  .toc-link.active {
    color: var(--color-accent, #2563eb);
    font-weight: 600;
    border-left-color: var(--color-accent, #2563eb);
    background-color: rgba(37, 99, 235, 0.04);
    border-radius: 0 var(--radius-sm, 4px) var(--radius-sm, 4px) 0;
  }

  /* Custom subtle scrollbar */
  .toc-widget::-webkit-scrollbar {
    width: 3px;
  }
  .toc-widget::-webkit-scrollbar-thumb {
    background-color: var(--color-border, #cbd5e1);
    border-radius: 3px;
  }
</style>
