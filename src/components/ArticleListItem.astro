---
import type { CollectionEntry } from 'astro:content';
import { formatDate, estimateReadingTime, getCategoryMeta } from '../lib/utils';

interface Props {
  article: CollectionEntry<'articles'>;
  headingLevel?: 'h2' | 'h3';
}

const { article, headingLevel = 'h2' } = Astro.props;
const { title, description, category, publishedAt, updatedAt } = article.data;

const categoryMeta = getCategoryMeta(category);
const readTime = estimateReadingTime(article.body);
const articleUrl = `/articles/${article.slug}/`;
const HeadingTag = headingLevel;
---

<article class="article-list-item">
  <div class="item-meta">
    <a href={`/category/${category}/`} class="category-badge">
      {categoryMeta.name}
    </a>
    <span class="meta-date">{formatDate(updatedAt || publishedAt)}</span>
    <span class="meta-divider">•</span>
    <span class="meta-readtime">{readTime} 分钟阅读</span>
  </div>

  <HeadingTag class="item-title">
    <a href={articleUrl} class="title-link">{title}</a>
  </HeadingTag>

  <p class="item-excerpt">{description}</p>
</article>

<style>
  .article-list-item {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.2s ease;
  }

  .article-list-item:first-child {
    padding-top: 0.5rem;
  }

  .article-list-item:last-child {
    border-bottom: none;
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .category-badge {
    color: var(--color-primary);
    background-color: var(--color-bg-subtle);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.8rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .category-badge:hover {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .meta-divider {
    color: var(--color-border);
  }

  .item-title {
    font-size: 1.35rem;
    line-height: 1.4;
    margin: 0 0 0.65rem 0;
    font-weight: 700;
  }

  .title-link {
    color: var(--color-text-main);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .title-link:hover {
    color: var(--color-primary);
  }

  .item-excerpt {
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.68;
    margin: 0;
  }

  @media (max-width: 640px) {
    .article-list-item {
      padding: 1.25rem 0;
    }
    .item-title {
      font-size: 1.2rem;
    }
    .item-excerpt {
      font-size: 0.95rem;
    }
  }
</style>
