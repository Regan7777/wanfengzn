---

<aside class="tag-floating-widget is-collapsed" id="tag-widget" aria-label="主题热门标签">
  <!-- Collapsed Tab Handle -->
  <button class="tag-widget-handle" id="tag-widget-expand-btn" title="点击展开热门标签" aria-label="点击展开热门标签">
    <span class="handle-icon">🏷️</span>
    <span class="handle-text">热门标签</span>
    <span class="handle-arrow">‹</span>
  </button>

  <!-- Main Floating Content Card -->
  <div class="tag-widget-card" id="tag-widget-card">
    <div class="tag-widget-header">
      <div class="header-left">
        <span class="header-icon">🏷️</span>
        <h3 class="header-title">机场与VPN热门主题标签</h3>
        <span class="header-count">{totalTagsCount}</span>
      </div>
      <button class="tag-widget-close-btn" id="tag-widget-collapse-btn" title="收起标签悬窗" aria-label="收起标签悬窗">
        <span class="close-icon">›</span>
      </button>
    </div>

    <div class="tag-widget-body">
      {tagGroups.map((group) => (
        <div class="tag-group">
          <div class="group-title">
            <span class="group-icon">{group.icon}</span>
            <span>{group.category}</span>
          </div>
          <div class="tag-list">
            {group.tags.map((tag) => (
              <a href={`/tag/${encodeURIComponent(tag.slug)}/`} class="tag-pill">
                #{tag.name}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.getElementById('tag-widget');
    const expandBtn = document.getElementById('tag-widget-expand-btn');
    const collapseBtn = document.getElementById('tag-widget-collapse-btn');

    const STORAGE_KEY = 'airport_tags_widget_collapsed';

    // Default to COLLAPSED (closed) unless explicitly opened by user
    const savedState = localStorage.getItem(STORAGE_KEY);
    if (savedState === 'false') {
      widget?.classList.remove('is-collapsed');
    } else {
      widget?.classList.add('is-collapsed');
    }

    expandBtn?.addEventListener('click', () => {
      widget?.classList.remove('is-collapsed');
      localStorage.setItem(STORAGE_KEY, 'false');
    });

    collapseBtn?.addEventListener('click', () => {
      widget?.classList.add('is-collapsed');
      localStorage.setItem(STORAGE_KEY, 'true');
    });
  });
</script>

<style>
  .tag-floating-widget {
    position: fixed;
    right: 20px;
    top: 420px;
    z-index: 999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Collapsed handle style */
  .tag-widget-handle {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #0f172a;
    color: #ffffff;
    border-radius: 24px 0 0 24px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.25);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-right: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .tag-widget-handle:hover {
    background: #1e293b;
    transform: translateX(-4px);
  }

  .handle-badge {
    background: #2563eb;
    color: #fff;
    font-size: 0.72rem;
    padding: 2px 7px;
    border-radius: 10px;
    font-weight: 800;
  }

  .handle-arrow {
    font-size: 1.1rem;
    line-height: 1;
  }

  /* Expanded Card Window */
  .tag-widget-card {
    width: 320px;
    max-height: calc(100vh - 180px);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    box-shadow: 0 12px 32px -4px rgba(15, 23, 42, 0.14), 0 4px 12px -2px rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
  }

  .tag-widget-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-icon {
    font-size: 1.1rem;
  }

  .header-title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .header-count {
    background: #e2e8f0;
    color: #334155;
    font-size: 0.75rem;
    padding: 2px 7px;
    border-radius: 12px;
    font-weight: 700;
  }

  .tag-widget-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #475569;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
    transition: all 0.2s ease;
    border: none;
  }

  .tag-widget-close-btn:hover {
    background: #0f172a;
    color: #ffffff;
  }

  .tag-widget-body {
    padding: 14px 16px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tag-widget-body::-webkit-scrollbar {
    width: 5px;
  }
  .tag-widget-body::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }

  .tag-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .group-icon {
    font-size: 0.9rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-pill {
    font-size: 0.78rem;
    font-weight: 600;
    color: #334155;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 4px 10px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .tag-pill:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
  }

  /* Collapsed state */
  .tag-floating-widget.is-collapsed .tag-widget-card {
    opacity: 0;
    transform: translateX(30px) scale(0.95);
    visibility: hidden;
    pointer-events: none;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .tag-floating-widget.is-collapsed .tag-widget-handle {
    display: flex;
  }

  /* Mobile responsiveness */
  @media (max-width: 1024px) {
    .tag-floating-widget {
      top: auto;
      bottom: 24px;
      right: 16px;
    }

    .tag-widget-card {
      width: 295px;
      max-height: 440px;
    }
  }
</style>
