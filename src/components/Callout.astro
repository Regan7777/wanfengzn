---
interface Props {
  type?: 'info' | 'warning' | 'success';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const iconMap = {
  info: '💡',
  warning: '⚠️',
  success: '✅'
};
---

<div class:list={['callout', `callout-${type}`]}>
  {title && (
    <div class="callout-title">
      <span class="callout-icon">{iconMap[type]}</span>
      <span>{title}</span>
    </div>
  )}
  <div class="callout-content">
    <slot />
  </div>
</div>
