---
import type { CollectionEntry } from 'astro:content';
import { formatDate, estimateReadingTime, getCategoryMeta } from '../lib/utils';

interface Props {
  article: CollectionEntry<'articles'>;
  headingLevel?: 'h2' | 'h3';
  showCategory?: boolean;
}

const { article, headingLevel = 'h3', showCategory = true } = Astro.props;
const { title, description, category, publishedAt, updatedAt, cover, coverAlt, tags } = article.data;

const categoryMeta = getCategoryMeta(category);
const readTime = estimateReadingTime(article.body);
const articleUrl = `/articles/${article.slug}/`;
const HeadingTag = headingLevel;
---

<article class="article-card">
  {cover && (
    <a href={articleUrl} class="card-cover-link" tab-index="-1" aria-hidden="true">
      <img
        src={cover}
        alt={coverAlt || title}
        width="400"
        height="225"
        loading="lazy"
        decoding="async"
        class="card-cover"
      />
    </a>
  )}

  <div class="card-body">
    <div class="card-meta-top">
      {showCategory && (
        <a href={`/category/${category}/`} class="category-tag">
          {categoryMeta.name}
        </a>
      )}
      <span class="meta-date">{formatDate(updatedAt || publishedAt)}</span>
      <span class="meta-divider">•</span>
      <span class="meta-readtime">{readTime} 分钟阅读</span>
    </div>

    <HeadingTag class="card-title">
      <a href={articleUrl} class="title-link">{title}</a>
    </HeadingTag>

    <p class="card-excerpt">{description}</p>

    {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.slice(0, 3).map((tag) => (
          <a href={`/tag/${encodeURIComponent(tag)}/`} class="tag-item">
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .article-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-hover);
  }

  .card-cover-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-subtle);
  }

  .card-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-card:hover .card-cover {
    transform: scale(1.03);
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .category-tag {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .meta-divider {
    color: var(--color-border-hover);
  }

  .card-title {
    margin: 0 0 0.6rem;
    line-height: 1.35;
    font-size: 1.15rem;
  }

  .title-link {
    color: var(--color-text-main);
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--color-primary);
  }

  .card-excerpt {
    font-size: 0.925rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .tag-item {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .tag-item:hover {
    color: var(--color-primary);
  }
</style>
