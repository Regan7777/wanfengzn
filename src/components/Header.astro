---
import { SITE_CONFIG } from '../config';

const currentPathname = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/') return currentPathname === '/';
  return currentPathname.startsWith(path);
}

// 精简顶级导航呈现 (与模板视觉一致)
const topNavItems = [
  { title: '首页', path: '/' },
  { title: '机场推荐', path: '/recommend/' },
  { title: '机场评测', path: '/reviews/' },
  { title: '客户端', path: '/clients/' },
  { title: '线路知识', path: '/network/' },
  { title: '使用教程', path: '/tutorials/' },
  { title: '排错指南', path: '/problems/' }
];
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="site-logo" aria-label="首页">
      <img src="/images/logo.png" alt={SITE_CONFIG.siteName} class="header-logo-img" />
      <span class="logo-bold">{SITE_CONFIG.siteName}</span>
    </a>

    <!-- Navigation Links -->
    <nav class="desktop-nav" aria-label="主导航">
      <ul class="nav-list">
        {topNavItems.map((item) => (
          <li>
            <a
              href={item.path}
              class:list={[
                'nav-link',
                { active: isActive(item.path) }
              ]}
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Search Icon & Bookmark Badge) -->
    <div class="header-actions">
      <a href="/search/" class="icon-btn" aria-label="搜索文章">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <a href="/recommend/" class="icon-btn bookmark-btn" aria-label="核心推荐" title="核心推荐">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
      </a>

      <!-- Mobile Menu Toggle -->
      <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="切换菜单" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="mobile-drawer-brand">
      <img src="/images/logo.png" alt={SITE_CONFIG.siteName} class="mobile-drawer-logo" />
      <div>
        <div class="mobile-brand-name">{SITE_CONFIG.siteName}</div>
        <div class="mobile-brand-desc">独立网络技术与客观评测博客</div>
      </div>
    </div>
    <nav aria-label="移动端导航">
      <ul class="mobile-nav-list">
        {SITE_CONFIG.navigation.map((item) => (
          <li>
            <a
              href={item.path}
              class:list={[
                'mobile-nav-link',
                { active: isActive(item.path) }
              ]}
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text-main);
    transition: opacity 0.15s ease;
  }

  .site-logo:hover {
    opacity: 0.9;
  }

  .header-logo-img {
    height: 42px;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .logo-bold {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: #0f172a;
    background: linear-gradient(135deg, #0f172a 0%, #334155 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: 0.935rem;
    font-weight: 500;
    color: #475569;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover, .nav-link.active {
    color: #0f172a;
    font-weight: 700;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: #475569;
    transition: all 0.15s ease;
  }

  .icon-btn:hover {
    color: #0f172a;
    background-color: var(--color-bg-subtle);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 32px;
    padding: 4px;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-main);
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  .mobile-drawer {
    display: none;
    position: absolute;
    top: var(--header-height);
    left: 0;
    right: 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    padding: 1rem 1.25rem 1.5rem;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-drawer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-drawer-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .mobile-brand-name {
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--color-text-main);
  }

  .mobile-brand-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .mobile-nav-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.65rem 0.85rem;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--color-text-main);
    text-align: center;
  }

  .mobile-nav-link.active {
    background-color: #e2e8f0;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      drawer.classList.toggle('open');
    });
  }
</script>
