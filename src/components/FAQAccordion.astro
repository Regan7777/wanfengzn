---
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  title?: string;
  description?: string;
}

const { faqs, title = '常见问题解答 (FAQ)', description } = Astro.props;

if (!faqs || faqs.length === 0) return null;
---

<section class="faq-section">
  {title && <h2 class="faq-title">{title}</h2>}
  {description && <p class="faq-desc">{description}</p>}

  <div class="faq-list">
    {faqs.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary class="faq-question">
          <span class="q-icon">Q:</span>
          <span class="q-text">{item.question}</span>
          <span class="toggle-icon">▼</span>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section {
    margin: 2.5rem 0;
    padding: 1.75rem;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .faq-title {
    font-size: 1.35rem;
    color: var(--color-text-main);
    margin-top: 0;
    margin-bottom: 0.5rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .faq-desc {
    font-size: 0.925rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    padding: 1rem 1.15rem;
    font-weight: 700;
    font-size: 1.025rem;
    color: var(--color-text-main);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-icon {
    color: var(--color-primary);
    font-weight: 800;
  }

  .q-text {
    flex-grow: 1;
  }

  .toggle-icon {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .toggle-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-answer {
    padding: 0 1.15rem 1rem 2.35rem;
    color: var(--color-text-secondary);
    font-size: 0.975rem;
    line-height: 1.65;
  }

  .faq-answer p {
    margin: 0;
  }
</style>
