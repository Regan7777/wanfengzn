---
import { SITE_CONFIG } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand-section">
      <a href="/" class="footer-logo-link">
        <img src="/images/logo.png" alt={SITE_CONFIG.siteName} class="footer-logo-img" />
        <span class="footer-brand-name">{SITE_CONFIG.siteName}</span>
      </a>
      <p class="footer-brand-tagline">专注网络技术解析、晚高峰客观实测与服务商透明评测</p>
    </div>

    <div class="footer-bottom-bar">
      <div class="copyright-text">
        &copy; {currentYear} {SITE_CONFIG.siteName} .
      </div>
      <div class="footer-meta-links">
        <a href="/about/" class="footer-meta-link">关于我们</a>
        <span class="dot">•</span>
        <a href={SITE_CONFIG.tgChannel} target="_blank" rel="noopener noreferrer" class="footer-meta-link">TG 群组/频道</a>
        <span class="dot">•</span>
        <a href={SITE_CONFIG.tgUser} target="_blank" rel="noopener noreferrer" class="footer-meta-link">联系站长</a>
        <span class="dot">•</span>
        <a href="/recommend/" class="footer-meta-link">核心推荐</a>
        <span class="dot">•</span>
        <a href="/guide/" class="footer-meta-link">新手指南</a>
        <span class="dot">•</span>
        <a href="/privacy/" class="footer-meta-link">隐私政策</a>
        <span class="dot">•</span>
        <a href="/sitemap-index.xml" class="footer-meta-link">站点地图</a>
        <span class="dot">•</span>
        <a href="/llms.txt" class="footer-meta-link">llms.txt</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
    margin-top: auto;
    font-size: 0.825rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .footer-brand-section {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text-main);
  }

  .footer-logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .footer-brand-name {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: #0f172a;
  }

  .footer-brand-tagline {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
  }

  .footer-bottom-bar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright-text {
    color: #64748b;
    font-weight: 500;
  }

  .footer-meta-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .footer-meta-link {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-meta-link:hover {
    color: #0f172a;
  }

  .dot {
    color: #cbd5e1;
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .footer-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
